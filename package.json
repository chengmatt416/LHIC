{
  "name": "lhic-core-academic",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Academic reference artifact for crash-consistent, evidence-carrying agent execution.",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "bench": "node --experimental-strip-types benchmark/failure-injection.ts",
    "experiment:browser": "node --experimental-strip-types experiments/real/browser.ts",
    "experiment:desktop": "xvfb-run -a node --experimental-strip-types experiments/real/desktop.ts",
    "experiment:code": "node --experimental-strip-types experiments/real/code.ts",
    "experiment:matrix": "node --experimental-strip-types experiments/real/failure-matrix.ts",
    "experiment:real": "node --experimental-strip-types experiments/real/run-all.ts && node --experimental-strip-types experiments/real/failure-matrix.ts"
  },
  "engines": {
    "node": ">=22.6"
  }
}
